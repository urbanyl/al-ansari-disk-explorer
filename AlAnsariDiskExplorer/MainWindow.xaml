<Window x:Class="AlAnsariDiskExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AlAnsariDiskExplorer.ViewModels"
        Title="Al-Ansari Disk Explorer v1.0.0 - Large File Finder"
        Width="1220" Height="840"
        MinWidth="1020" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{x:Static SystemColors.ControlBrush}"
        FontFamily="Segoe UI"
        FontSize="12">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Scan">
                <MenuItem Header="_Scan folder" Command="{Binding ScanCommand}" />
                <MenuItem Header="_Stop" Command="{Binding CancelCommand}" />
                <Separator />
                <MenuItem Header="_Refresh drives" Command="{Binding RefreshDrivesCommand}" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Open Recycle Bin" Command="{Binding OpenRecycleBinCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding ProgressText}" FontSize="11" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Scan" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Drive:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Grid.Column="1" Height="24" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding Drives}"
                                  SelectedItem="{Binding SelectedDrive, Mode=TwoWay}" />

                        <TextBlock Grid.Column="2" Text="Folder:" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <TextBox Grid.Column="3" Height="24" VerticalContentAlignment="Center"
                                 Text="{Binding RootPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Grid.Column="4" Content="Browse..." Padding="10,2" Margin="6,0,0,0"
                                Command="{Binding BrowseCommand}" />
                        <Button Grid.Column="5" Content="Scan" Padding="16,2" Margin="6,0,0,0"
                                Command="{Binding ScanCommand}" />
                        <Button Grid.Column="6" Content="Stop" Padding="14,2" Margin="6,0,0,0"
                                Command="{Binding CancelCommand}" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ProgressBar Grid.Column="0" Height="16"
                                     IsIndeterminate="{Binding IsScanning}"
                                     Minimum="0" Maximum="100" />
                        <TextBlock Grid.Column="0" Text="{Binding ProgressText}" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{x:Static SystemColors.GrayTextBrush}" />
                        <CheckBox Grid.Column="1" Content="Show protected files (red)"
                                  IsChecked="{Binding ShowProtected}" Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  ToolTip="When unchecked, protected files and folders are skipped entirely during the next scan." />
                    </Grid>
                </Grid>
            </GroupBox>

            <TabControl Grid.Row="1" Margin="0,8,0,0">

                <TabItem Header="Largest files">
                    <ListView x:Name="FileList"
                              ItemsSource="{Binding FilesView}"
                              SelectionMode="Extended"
                              SelectionChanged="FileList_SelectionChanged"
                              MouseDoubleClick="FileList_MouseDoubleClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                        <Setter Property="Foreground" Value="#C00000" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="245" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Size" Width="85" DisplayMemberBinding="{Binding SizeText}" />
                                <GridViewColumn Header="Modified" Width="125" DisplayMemberBinding="{Binding ModifiedText}" />
                                <GridViewColumn Header="Status" Width="80" DisplayMemberBinding="{Binding StatusText}" />
                                <GridViewColumn Header="Type" Width="55" DisplayMemberBinding="{Binding TypeText}" />
                                <GridViewColumn Header="Folder" Width="520" DisplayMemberBinding="{Binding Folder}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>

                <TabItem Header="Largest folders">
                    <ListView x:Name="FolderList"
                              ItemsSource="{Binding FoldersView}"
                              MouseDoubleClick="FolderList_MouseDoubleClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                        <Setter Property="Foreground" Value="#C00000" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Folder" Width="220" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Size" Width="85" DisplayMemberBinding="{Binding SizeText}" />
                                <GridViewColumn Header="Files" Width="70" DisplayMemberBinding="{Binding FileCountText}" />
                                <GridViewColumn Header="Status" Width="80" DisplayMemberBinding="{Binding StatusText}" />
                                <GridViewColumn Header="Path" Width="650" DisplayMemberBinding="{Binding FullPath}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>

                <TabItem Header="Deletion log">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Refresh log" Padding="14,4"
                                    Command="{Binding RefreshLogCommand}" />
                        </StackPanel>
                        <TextBox Text="{Binding LogText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" />
                    </DockPanel>
                </TabItem>
            </TabControl>

            <GroupBox Grid.Row="2" Header="Summary" Padding="8" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Scanned: " FontWeight="Bold" />
                            <TextBlock>
                                <Run Text="{Binding TotalFilesText, Mode=OneWay}" /><Run Text=" files  |  " /><Run Text="{Binding TotalSizeText, Mode=OneWay}" /><Run Text=" | " /><Run Text="{Binding TotalFoldersText, Mode=OneWay}" /><Run Text=" folders" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Margin="0,3,0,0">
                            <Run Text="Free space: " FontWeight="Bold" /><Run Text="{Binding FreeSpaceText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="0,3,0,0">
                            <Run Text="Selection: " FontWeight="Bold" /><Run Text="{Binding SelectionText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="0,6,0,0" FontSize="11"
                                   Foreground="{x:Static SystemColors.GrayTextBrush}"
                                   Text="Files marked Protected are shown in red and cannot be deleted by this application." />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="Send to Recycle Bin" Padding="12,4" Margin="0,0,0,5"
                                Click="DeleteToRecycle_Click" />
                        <Button Content="Delete permanently" Padding="12,4" Margin="0,0,0,5"
                                Click="DeletePermanently_Click" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Open location" Padding="12,4"
                                    Click="OpenLocation_Click" />
                            <Button Content="Recycle Bin" Padding="12,4" Margin="6,0,0,0"
                                    Command="{Binding OpenRecycleBinCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>




